{
  "manifest_version": 3,
  "name": "Vertion Leads — Prospector do Google Maps",
  "version": "1.0.0",
  "description": "Varre o Google Maps por comércios e separa quem não tem site próprio. Envia tudo para o painel Vertion Leads.",
  "permissions": ["storage", "tabs", "scripting", "downloads"],
  "host_permissions": [
    "https://www.google.com/*",
    "https://*/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Vertion Leads",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["https://www.google.com/maps/*", "https://www.google.com.br/maps/*"],
      "js": ["lib/classify.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
