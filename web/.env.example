# Nomes das variáveis que o Vertion Leads usa. NUNCA coloque valores aqui:
# este arquivo vai para o GitHub. Os valores ficam só na Vercel
# (Settings -> Environment Variables) e, para rodar no computador, em
# .env.local (que o Git ignora).
#
# Só as que começam com NEXT_PUBLIC_ podem aparecer no navegador, e nenhuma
# delas é segredo. Todas as outras ficam apenas no servidor.

# --- Banco e login (Supabase)
SUPABASE_DB_URL=                 # conexão do papel app_vertion (segredo)
NEXT_PUBLIC_SUPABASE_URL=        # endereço do projeto (público)
NEXT_PUBLIC_SUPABASE_ANON_KEY=   # chave pública; o RLS e os grants não deixam ela ler nada
NEXT_PUBLIC_LOGIN_GOOGLE=        # "1" mostra o botão Entrar com Google
NEXT_PUBLIC_SITE_URL=
SITE_URL=                        # https://leads.vertionstack.com

# --- Segredos de assinatura (texto aleatório longo, um diferente para cada)
PROPOSTA_SECRET=                 # links de proposta e prévia
EMAIL_SECRET=                    # link "não quero receber" dos e-mails
TESTE_SAL=                       # trava do teste grátis
CRON_SECRET=                     # a Vercel usa para chamar /api/cron/avisos

# --- Central de administração
ADMIN_EMAILS=
ADMIN_CAMINHO=
ADMIN_CHAVE=

# --- Google Places
GOOGLE_PLACES_KEY=
BUSCA_TETO_DIA=
BUSCA_TETO_MES=
BUSCA_TETO_TESTES=

# --- Pagamento (Stripe)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRECO_BASIC=
STRIPE_PRECO_PRO=
STRIPE_PIX=

# --- E-mail (Resend)
RESEND_API_KEY=
EMAIL_REMETENTE=

# --- WhatsApp da Vertion pela Evolution API (só a conta em CONVERSA_EMAILS usa; envio só com clique)
CONVERSA_EMAILS=                 # quem usa conversas, IA e WhatsApp (padrão vertionstack@gmail.com)
EVOLUTION_URL=                   # endereço do servidor da Evolution (https://...)
EVOLUTION_API_KEY=               # chave global do servidor (AUTHENTICATION_API_KEY)
EVOLUTION_INSTANCIA=             # nome da conexão, ex.: vertion
EVOLUTION_SEGREDO_WEBHOOK=       # texto aleatório longo, conferido no webhook

# --- Dados da empresa nos documentos
EMPRESA_NOME=
EMPRESA_EMAIL=
EMPRESA_SITE=
EMPRESA_TELEFONE=
LEGAL_NOME=
LEGAL_DOCUMENTO=
LEGAL_EMAIL=
LEGAL_FORO=
