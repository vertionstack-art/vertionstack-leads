# Copie para .env.local ao rodar na sua maquina.
# Na Vercel, cadastre estas mesmas variaveis em Settings -> Environment Variables.

# Banco de dados Postgres. Na Vercel: Storage -> Create Database -> Neon.
# A Vercel preenche esta variavel sozinha ao conectar o banco ao projeto.
DATABASE_URL=

# Chave que a extensao usa para enviar os leads.
# Precisa ser identica a que esta nas configuracoes da extensao.
INGEST_TOKEN=

# Senha para abrir o painel no navegador.
DASHBOARD_PASSWORD=
